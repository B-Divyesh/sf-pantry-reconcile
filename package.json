    "@playwright/test": "1.58.2",
    "@types/node": "22.15.3",
    "eslint": "9.32.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
